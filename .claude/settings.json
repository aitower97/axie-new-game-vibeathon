{
  "_comment": "Hooks del hub-agentes-app (.claude/agents-hub): check-rls.sh es no-op sin migraciones de Supabase (este proyecto no usa Supabase), check-build.sh corre 'npm run build' al terminar un subagente.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/agents-hub/hooks/check-rls.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/agents-hub/hooks/check-build.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
